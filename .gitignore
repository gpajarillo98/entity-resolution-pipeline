__pycache__/
*.pyc
.venv/
.venv-airflow/
venv/

# Airflow's own runtime files if AIRFLOW_HOME ever points inside the repo
airflow.cfg
airflow.db
logs/
webserver_config.py

# raw source data is pulled fresh from the city's open data portal --
# don't commit large CSV exports to the repo
data/raw/*.csv
data/processed/*.csv

# dbt seeds are copies of data/processed/*.csv -- same reasoning, and
# they regenerate from `python run_pipeline.py` + a copy step (see
# README "Running with dbt")
dbt/seeds/*.csv
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/*.duckdb

# Snowflake credentials should only ever live in environment variables or
# ~/.dbt/profiles.yml (outside the repo) -- this is a defensive backstop
# in case a .env file ever gets created for convenience locally
.env
*.env

.DS_Store
